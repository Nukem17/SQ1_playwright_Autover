{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lancyr: tests starten",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/testmenu.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
    {
      "label": "Lancyr: rapportage openen",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/testmenu.sh",
        "--reports"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
