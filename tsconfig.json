{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "playwright.config.ts",
    "test/**/*.ts",
    "testdata/**/*.ts",
    "testdata/**/*.mts"
  ]
}
